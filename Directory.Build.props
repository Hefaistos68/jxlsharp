<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <!-- Ownership Metadata -->
    <Authors>Hefaistos68</Authors>
    <Company>Hefaistos68</Company>
    <Product>JxlSharp</Product>
    <Copyright>Copyright (c) Hefaistos68</Copyright>
    <PackageProjectUrl>https://github.com/Hefaistos68/jxl-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hefaistos68/jxl-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
