root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
csharp_style_namespace_declarations = block_scoped:error
csharp_prefer_simple_program_statement = false:error
dotnet_PerMethodCognitiveComplexityThreshold = 15
dotnet_MaxMethodParameterCount = 7
