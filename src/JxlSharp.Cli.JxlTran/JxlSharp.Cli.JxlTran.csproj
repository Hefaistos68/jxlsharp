<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>jxltran</AssemblyName>
    <RootNamespace>JxlSharp.Cli.JxlTran</RootNamespace>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcInstructionSet>native</IlcInstructionSet>
    <EventSourceSupport>true</EventSourceSupport>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <Description>JPEG XL container manipulation command-line tool (jxltran).</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JxlSharp\JxlSharp.csproj" />
    <ProjectReference Include="..\JxlSharp.Extras\JxlSharp.Extras.csproj" />
    <ProjectReference Include="..\JxlSharp.Tools\JxlSharp.Tools.csproj" />
  </ItemGroup>
</Project>
